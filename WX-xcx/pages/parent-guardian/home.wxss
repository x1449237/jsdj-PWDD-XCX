.home-page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 60rpx;
}

.header-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 60%, #8b5cf6 100%);
  padding: 70rpx 40rpx 90rpx;
  color: #ffffff;
  position: relative;
  overflow: hidden;
}

.header-card::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -40rpx;
  width: 280rpx;
  height: 280rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.header-icon {
  font-size: 72rpx;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 28rpx;
  position: relative;
  z-index: 1;
}

.header-text {
  flex: 1;
  position: relative;
  z-index: 1;
}

.header-title {
  font-size: 42rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

.content {
  margin-top: -50rpx;
  padding: 0 24rpx;
}

.empty-card {
  background: #ffffff;
  margin: 40rpx 24rpx;
  border-radius: 20rpx;
  padding: 100rpx 48rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.06);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #303133;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: #909399;
  margin-bottom: 48rpx;
  line-height: 1.6;
}

.bind-btn {
  width: 480rpx;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 46rpx;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.25);
}

.btn-plus {
  font-size: 34rpx;
  font-weight: 500;
}

.bind-btn::after {
  border: none;
}

.child-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.child-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.child-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.frozen-badge {
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #f56c6c;
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}

.child-info {
  flex: 1;
  min-width: 0;
}

.child-nickname {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.status-tag {
  font-size: 20rpx;
  font-weight: 500;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.status-tag.active {
  background: #e6faf0;
  color: #059669;
}

.status-tag.frozen {
  background: #fef2f2;
  color: #dc2626;
}

.child-meta {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 6rpx;
}

.switch-child {
  display: inline-block;
  font-size: 24rpx;
  color: #667eea;
  background: #eef2ff;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-top: 4rpx;
}

.add-child-btn {
  width: 64rpx;
  height: 64rpx;
  background: #f5f6fa;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #667eea;
  flex-shrink: 0;
}

.consume-card {
  background: linear-gradient(135deg, #fff 0%, #fefefe 100%);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.consume-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.consume-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.title-icon {
  font-size: 28rpx;
}

.consume-more {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
}

.consume-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 18rpx;
}

.amount-symbol {
  font-size: 30rpx;
  font-weight: 700;
  color: #e94560;
}

.amount-value {
  font-size: 52rpx;
  font-weight: 800;
  color: #e94560;
  letter-spacing: -0.5rpx;
}

.consume-limit {
  font-size: 26rpx;
  font-weight: normal;
  color: #9ca3af;
  margin-left: 8rpx;
}

.consume-progress-wrap {
  margin-bottom: 22rpx;
}

.progress-text-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.progress-text {
  font-size: 22rpx;
  color: #6b7280;
}

.consume-progress {
  height: 14rpx;
  background: #f0f2f5;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 10rpx;
  transition: width 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.progress-bar.danger {
  background: linear-gradient(90deg, #f59e0b, #dc2626);
}

.consume-limit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #374151;
  padding: 18rpx 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.limit-left {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.limit-icon {
  font-size: 26rpx;
}

.limit-value {
  font-weight: 600;
  color: #111827;
}

.edit-text {
  color: #667eea;
  font-weight: 500;
}

.setting-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.setting-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.setting-item.danger-item .setting-name {
  color: #dc2626;
}

.setting-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.setting-icon-wrap.order {
  background: #eff6ff;
}

.setting-icon-wrap.reward {
  background: #fff7ed;
}

.setting-icon-wrap.freeze {
  background: #fef2f2;
}

.setting-main {
  flex: 1;
  min-width: 0;
}

.setting-name {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.setting-desc {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.4;
}

.menu-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
  gap: 20rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.menu-icon.report {
  background: #eff6ff;
}

.menu-icon.chat {
  background: #ecfdf5;
}

.menu-text {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.menu-sub {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.4;
}

.menu-arrow {
  font-size: 32rpx;
  color: #d1d5db;
  font-weight: 500;
}

.unbind-row {
  padding: 10rpx 0 20rpx;
}

.unbind-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: #dc2626;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: none;
}

.unbind-btn::after {
  border: none;
}
