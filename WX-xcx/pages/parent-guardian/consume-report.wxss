.report-page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 60rpx;
}

.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 30rpx 40rpx 50rpx;
}

.month-selector .picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.18);
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  color: #fff;
}

.picker-label-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.picker-icon {
  font-size: 30rpx;
}

.picker-value {
  font-size: 30rpx;
  font-weight: 700;
}

.picker-arrow {
  font-size: 24rpx;
  opacity: 0.9;
}

.summary-card {
  margin: -30rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(102, 126, 234, 0.08);
  position: relative;
  z-index: 2;
}

.summary-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.summary-icon {
  font-size: 28rpx;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
}

.summary-amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx;
}

.summary-amount-item {
  flex: 1;
  text-align: center;
}

.summary-divider {
  width: 1rpx;
  height: 70rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.amount-label {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
}

.amount-value-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.amount-symbol {
  font-size: 24rpx;
  color: #e94560;
  font-weight: 600;
}

.amount-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.amount-value.big {
  font-size: 42rpx;
  color: #e94560;
}

.amount-value.up {
  color: #e94560;
}

.amount-value.down {
  color: #059669;
}

.amount-unit {
  font-size: 22rpx;
  color: #6b7280;
  margin-left: 4rpx;
}

.tabs-wrap {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  position: sticky;
  top: 10rpx;
  z-index: 5;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.tabs {
  display: flex;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 4rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 10rpx;
  transition: all 0.25s;
  font-weight: 500;
}

.tab-item.active {
  background: #fff;
  color: #667eea;
  font-weight: 700;
  box-shadow: 0 2rpx 10rpx rgba(102, 126, 234, 0.12);
}

.tab-content {
  padding: 20rpx 24rpx 0;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.section-title .icon {
  font-size: 28rpx;
}

.category-card,
.trend-card,
.orders-card,
.chat-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.category-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.category-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #eef2ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.category-info {
  flex: 1;
  min-width: 0;
}

.category-name {
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.category-count {
  font-size: 22rpx;
  color: #9ca3af;
}

.category-right .category-amount {
  font-size: 28rpx;
  color: #111827;
  font-weight: 700;
}

.trend-chart {
  padding: 20rpx 0 10rpx;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8rpx;
  height: 260rpx;
  padding: 0 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.chart-bar-wrap {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.chart-bar {
  width: 70%;
  min-height: 8rpx;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  border-radius: 6rpx 6rpx 0 0;
  transition: height 0.4s ease;
}

.chart-labels {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 10rpx 0;
  gap: 8rpx;
}

.chart-label {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: #9ca3af;
}

.empty-orders {
  padding: 80rpx 0 60rpx;
  text-align: center;
}

.empty-orders .empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-orders .empty-text {
  font-size: 26rpx;
  color: #9ca3af;
}

.load-more-tip {
  padding: 30rpx 0 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}

.order-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.order-item:last-child {
  border-bottom: none;
}

.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-sn {
  font-size: 24rpx;
  color: #6b7280;
  font-family: monospace;
}

.order-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
}

.order-status.status-4 {
  background: #ecfdf5;
  color: #059669;
}

.order-status.status-3 {
  background: #fff7ed;
  color: #d97706;
}

.order-status.status-2 {
  background: #eff6ff;
  color: #2563eb;
}

.order-status.status-5 {
  background: #f3f4f6;
  color: #6b7280;
}

.order-status.status-0,
.order-status.status-1 {
  background: #fef3c7;
  color: #d97706;
}

.order-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.order-info {
  flex: 1;
  min-width: 0;
}

.order-game,
.order-desc,
.order-time {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 6rpx;
}

.order-game {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 600;
}

.order-desc {
  font-size: 24rpx;
  color: #6b7280;
}

.order-time {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 0;
}

.game-icon, .time-icon {
  font-size: 24rpx;
}

.order-amount {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.order-amount .amount-symbol {
  font-size: 22rpx;
}

.order-amount .amount-value {
  font-size: 30rpx;
  color: #111827;
  font-weight: 700;
}

.card-notice {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: #eef2ff;
  color: #4f46e5;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.notice-icon {
  flex-shrink: 0;
  margin-top: 2rpx;
}

.chat-overview {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.overview-item {
  flex: 1;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 20rpx 10rpx;
  text-align: center;
}

.overview-icon {
  font-size: 32rpx;
  display: block;
  margin-bottom: 8rpx;
}

.overview-info {
  text-align: center;
}

.overview-value {
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
  margin-bottom: 4rpx;
}

.overview-value.danger {
  color: #dc2626;
}

.overview-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.chat-list {
  display: flex;
  flex-direction: column;
}

.chat-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  gap: 16rpx;
  position: relative;
}

.chat-item:last-child {
  border-bottom: none;
}

.chat-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #e5e7eb;
  flex-shrink: 0;
}

.chat-info {
  flex: 1;
  min-width: 0;
}

.chat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.chat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.chat-time {
  font-size: 22rpx;
  color: #9ca3af;
  flex-shrink: 0;
  margin-left: 10rpx;
}

.chat-preview {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.msg-mask {
  flex: 1;
  font-size: 24rpx;
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.no-msg {
  font-size: 24rpx;
  color: #9ca3af;
}

.sensitive-tag {
  font-size: 20rpx;
  color: #dc2626;
  background: #fef2f2;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.unread-dot {
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #f56c6c;
  color: #fff;
  border-radius: 18rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}
