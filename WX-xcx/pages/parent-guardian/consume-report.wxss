.report-page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 60rpx;
}

.page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 30rpx 40rpx 50rpx;
}

.month-selector .picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.18);
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  color: #fff;
}

.picker-label-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.picker-icon-bg {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  position: relative;
}
.picker-icon-bg::before {
  content: "";
  position: absolute;
  inset: 6rpx 6rpx 6rpx 6rpx;
  border: 2rpx solid #fff;
  border-top: 3rpx solid #fff;
  border-radius: 4rpx;
}
.picker-icon-bg::after {
  content: "";
  position: absolute;
  top: 6rpx;
  left: 8rpx;
  right: 8rpx;
  height: 2rpx;
  background: #fff;
}

.picker-value {
  font-size: 30rpx;
  font-weight: 700;
}

.picker-arrow {
  font-size: 24rpx;
  opacity: 0.9;
}

.summary-card {
  margin: -30rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx 32rpx;
  box-shadow: 0 6rpx 24rpx rgba(102, 126, 234, 0.08);
  position: relative;
  z-index: 2;
}

.summary-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.summary-icon-bg {
  width: 34rpx;
  height: 34rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #F59E0B 0%, #B45309 100%);
  position: relative;
}
.summary-icon-bg::before {
  content: "";
  position: absolute;
  bottom: 7rpx;
  left: 6rpx;
  right: 6rpx;
  height: 3rpx;
  background: #fff;
  border-radius: 2rpx;
}
.summary-icon-bg::after {
  content: "";
  position: absolute;
  top: 8rpx;
  left: 50%;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  transform: translateX(-70%);
}

.summary-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
}

.summary-amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx;
}

.summary-amount-item {
  flex: 1;
  text-align: center;
}

.summary-divider {
  width: 1rpx;
  height: 70rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.amount-label {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 8rpx;
}

.amount-value-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.amount-symbol {
  font-size: 24rpx;
  color: #e94560;
  font-weight: 600;
}

.amount-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.amount-value.big {
  font-size: 42rpx;
  color: #e94560;
}

.amount-value.up {
  color: #e94560;
}

.amount-value.down {
  color: #059669;
}

.amount-unit {
  font-size: 22rpx;
  color: #6b7280;
  margin-left: 4rpx;
}

.tabs-wrap {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  position: sticky;
  top: 10rpx;
  z-index: 5;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.tabs {
  display: flex;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 4rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 10rpx;
  transition: all 0.25s;
  font-weight: 500;
}

.tab-item.active {
  background: #fff;
  color: #667eea;
  font-weight: 700;
  box-shadow: 0 2rpx 10rpx rgba(102, 126, 234, 0.12);
}

.tab-content {
  padding: 20rpx 24rpx 0;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.section-title .icon-bg {
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.section-title .icon-bg.category {
  background: linear-gradient(135deg, #60A5FA 0%, #3B82F6 100%);
}
.section-title .icon-bg.trend {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  position: relative;
}
.section-title .icon-bg.trend::after {
  content: "";
  position: absolute;
  left: 5rpx;
  right: 5rpx;
  bottom: 6rpx;
  height: 12rpx;
  border: 3rpx solid #fff;
  border-right: none;
  border-top: none;
  border-radius: 0 0 0 2rpx;
  transform: skewX(-20deg);
}

.category-card,
.trend-card,
.orders-card,
.chat-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.category-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.category-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  position: relative;
}
.category-icon.cate-rank_boost { background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%); }
.category-icon.cate-companion { background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%); }
.category-icon.cate-reward { background: linear-gradient(135deg, #EC4899 0%, #DB2777 100%); }
.category-icon.cate-other { background: linear-gradient(135deg, #6B7280 0%, #4B5563 100%); }

.category-info {
  flex: 1;
  min-width: 0;
}

.category-name {
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.category-count {
  font-size: 22rpx;
  color: #9ca3af;
}

.category-right .category-amount {
  font-size: 28rpx;
  color: #111827;
  font-weight: 700;
}

.trend-chart {
  padding: 20rpx 0 10rpx;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8rpx;
  height: 260rpx;
  padding: 0 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.chart-bar-wrap {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.chart-bar {
  width: 70%;
  min-height: 8rpx;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  border-radius: 6rpx 6rpx 0 0;
  transition: height 0.4s ease;
}

.chart-labels {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 10rpx 0;
  gap: 8rpx;
}

.chart-label {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: #9ca3af;
}

.empty-orders {
  padding: 80rpx 0 60rpx;
  text-align: center;
}

.empty-orders .empty-icon-block {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: block;
  margin: 0 auto 16rpx;
  position: relative;
}
.empty-orders .empty-icon-block.order-empty {
  background: rgba(107, 114, 128, 0.1);
}
.empty-orders .empty-icon-block.order-empty::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 56rpx;
  height: 44rpx;
  border: 5rpx solid #9CA3AF;
  border-radius: 6rpx;
  transform: translate(-50%, -50%);
}
.empty-orders .empty-icon-block.order-empty::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 34rpx;
  width: 28rpx;
  height: 10rpx;
  border-bottom: 4rpx solid #9CA3AF;
  transform: translateX(-50%);
}
.empty-orders .empty-icon-block.chat-empty {
  background: rgba(96, 165, 250, 0.1);
}
.empty-orders .empty-icon-block.chat-empty::after {
  content: "";
  position: absolute;
  left: 32rpx;
  top: 32rpx;
  width: 48rpx;
  height: 38rpx;
  border: 5rpx solid #60A5FA;
  border-radius: 10rpx 10rpx 10rpx 0;
}
.empty-orders .empty-icon-block.chat-empty::before {
  content: "";
  position: absolute;
  left: 32rpx;
  bottom: 28rpx;
  width: 0;
  height: 0;
  border-left: 0rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-top: 14rpx solid #60A5FA;
}

.empty-orders .empty-text {
  font-size: 26rpx;
  color: #9ca3af;
}

.load-more-tip {
  padding: 30rpx 0 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
}

.order-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.order-item:last-child {
  border-bottom: none;
}

.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-sn {
  font-size: 24rpx;
  color: #6b7280;
  font-family: monospace;
}

.order-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
}

.order-status.status-4 {
  background: #ecfdf5;
  color: #059669;
}

.order-status.status-3 {
  background: #fff7ed;
  color: #d97706;
}

.order-status.status-2 {
  background: #eff6ff;
  color: #2563eb;
}

.order-status.status-5 {
  background: #f3f4f6;
  color: #6b7280;
}

.order-status.status-0,
.order-status.status-1 {
  background: #fef3c7;
  color: #d97706;
}

.order-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.order-info {
  flex: 1;
  min-width: 0;
}

.order-game,
.order-desc,
.order-time {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 6rpx;
}

.order-game {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 600;
}

.order-desc {
  font-size: 24rpx;
  color: #6b7280;
}

.order-time {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 0;
}

.game-icon-dot, .time-icon-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
  margin-right: 10rpx;
}
.game-icon-dot {
  margin-top: 6rpx;
  background: #3B82F6;
}
.time-icon-dot {
  margin-top: 6rpx;
  background: #9CA3AF;
}

.order-amount {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.order-amount .amount-symbol {
  font-size: 22rpx;
}

.order-amount .amount-value {
  font-size: 30rpx;
  color: #111827;
  font-weight: 700;
}

.card-notice {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: #eef2ff;
  color: #4f46e5;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.notice-icon-block {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  margin-top: 0rpx;
  background: #4F46E5;
  position: relative;
}
.notice-icon-block::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 12rpx;
  border: 3rpx solid #fff;
  border-top: none;
  border-right: none;
  transform: translate(-60%, -60%) rotate(-45deg);
}

.chat-overview {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.overview-item {
  flex: 1;
  background: #f9fafb;
  border-radius: 14rpx;
  padding: 20rpx 10rpx;
  text-align: center;
}

.overview-icon-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  display: block;
  margin: 0 auto 8rpx;
}
.overview-icon-dot.chat {
  background: #60A5FA;
}
.overview-icon-dot.chat-count {
  background: #8B5CF6;
}
.overview-icon-dot.sens {
  background: #EF4444;
  position: relative;
}
.overview-icon-dot.sens::after {
  content: "";
  position: absolute;
  top: 10rpx;
  left: 50%;
  width: 4rpx;
  height: 18rpx;
  background: #fff;
  border-radius: 2rpx;
  transform: translateX(-50%);
}
.overview-icon-dot.sens::before {
  content: "";
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  width: 4rpx;
  height: 4rpx;
  background: #fff;
  border-radius: 50%;
  transform: translateX(-50%);
}

.overview-info {
  text-align: center;
}

.overview-value {
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
  margin-bottom: 4rpx;
}

.overview-value.danger {
  color: #dc2626;
}

.overview-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.chat-list {
  display: flex;
  flex-direction: column;
}

.chat-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  gap: 16rpx;
  position: relative;
}

.chat-item:last-child {
  border-bottom: none;
}

.chat-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #e5e7eb;
  flex-shrink: 0;
}

.chat-info {
  flex: 1;
  min-width: 0;
}

.chat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.chat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.chat-time {
  font-size: 22rpx;
  color: #9ca3af;
  flex-shrink: 0;
  margin-left: 10rpx;
}

.chat-preview {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.msg-mask {
  flex: 1;
  font-size: 24rpx;
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.no-msg {
  font-size: 24rpx;
  color: #9ca3af;
}

.sensitive-tag {
  font-size: 20rpx;
  color: #dc2626;
  background: #fef2f2;
  padding: 2rpx 10rpx 2rpx 22rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  position: relative;
}
.sensitive-tag::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  background: #dc2626;
  border-radius: 2rpx;
  transform: translateY(-50%);
}

.unread-dot {
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #f56c6c;
  color: #fff;
  border-radius: 18rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}
