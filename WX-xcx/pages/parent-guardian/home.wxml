<view class="home-page">
  <view class="header-card">
    <view class="header-icon-block"></view>
    <view class="header-text">
      <view class="header-title">家长监护中心</view>
      <view class="header-subtitle">守护孩子健康上网，安心又省心</view>
    </view>
  </view>

  <view wx:if="{{bindList.length === 0 && !loading}}" class="empty-card">
    <view class="empty-icon-block"></view>
    <view class="empty-title">暂无绑定的孩子账号</view>
    <view class="empty-subtitle">绑定后可查看消费记录、设置消费限额和功能管控</view>
    <button class="bind-btn" bindtap="onGoBind">
      <text class="btn-plus">+</text>
      <text>立即绑定孩子</text>
    </button>
  </view>

  <view wx:if="{{bindList.length > 0}}" class="content">
    <view class="child-card">
      <view class="child-avatar-wrap">
        <image class="child-avatar" src="{{currentChild.avatar || '/assets/icons/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="frozen-badge" wx:if="{{setting.is_frozen == 1}}">已冻结</view>
      </view>
      <view class="child-info">
        <view class="child-nickname">
          {{currentChild.nickname || '孩子'}}
          <text wx:if="{{setting.is_frozen == 1}}" class="status-tag frozen">账号已冻结</text>
          <text wx:else class="status-tag active">监护中</text>
        </view>
        <view class="child-meta" wx:if="{{currentChild.user_id}}">
          用户ID：{{currentChild.user_id}}
        </view>
        <picker bindchange="onBindChange" value="{{bindListIndex}}" range="{{bindList}}" range-key="child_label">
          <view class="switch-child">
            <text wx:if="{{bindList.length > 1}}">切换孩子 ›</text>
            <text wx:else>管理绑定 ›</text>
          </view>
        </picker>
      </view>
      <view class="add-child-btn" bindtap="onGoBind">
        <text>+</text>
      </view>
    </view>

    <view class="consume-card">
      <view class="consume-header">
        <view class="consume-title">
          <view class="title-icon-bg coin"></view>
          本月消费
        </view>
        <view class="consume-more" bindtap="onGoConsumeReport">查看明细 ›</view>
      </view>
      <view class="consume-amount">
        <text class="amount-symbol">¥</text>
        <text class="amount-value">{{((monthConsume || 0) / 100).toFixed(2)}}</text>
        <text class="consume-limit" wx:if="{{monthlyLimit > 0}}"> / ¥{{(monthlyLimit / 100).toFixed(2)}}</text>
      </view>
      <view class="consume-progress-wrap">
        <view class="progress-text-row">
          <text class="progress-text">
            已用{{monthlyLimit > 0 ? Math.min(100, Math.round(monthConsume / monthlyLimit * 100)) : 0}}%
          </text>
          <text class="progress-text" wx:if="{{monthlyLimit > 0}}">
            剩余¥{{Math.max(0, ((monthlyLimit - monthConsume) / 100)).toFixed(2)}}
          </text>
        </view>
        <view class="consume-progress">
          <view
            class="progress-bar {{monthlyLimit > 0 && monthConsume >= monthlyLimit ? 'danger' : ''}}"
            style="width: {{monthlyLimit > 0 ? Math.min(100, Math.round(monthConsume / monthlyLimit * 100)) : 0}}%"
          ></view>
        </view>
      </view>
      <view class="consume-limit-row" bindtap="onEditLimit">
        <view class="limit-left">
          <view class="limit-icon-bg"></view>
          <text>月消费限额：</text>
          <text class="limit-value">
            {{monthlyLimit > 0 ? '¥' + (monthlyLimit / 100).toFixed(2) : '未设置'}}
          </text>
        </view>
        <text class="edit-text">{{monthlyLimit > 0 ? '修改' : '去设置'}}</text>
      </view>
    </view>

    <view class="setting-card">
      <view class="card-title">
        <view class="title-icon-bg gear"></view>
        功能管控
      </view>

      <view class="setting-item">
        <view class="setting-info">
          <view class="setting-icon-bg order"></view>
          <view class="setting-main">
            <view class="setting-name">允许下单</view>
            <view class="setting-desc">关闭后孩子将无法下单新服务</view>
          </view>
        </view>
        <switch
          checked="{{setting.allow_order == 1}}"
          bindchange="onToggleOrder"
          color="#4f8cff"
        />
      </view>

      <view class="setting-item">
        <view class="setting-info">
          <view class="setting-icon-bg reward"></view>
          <view class="setting-main">
            <view class="setting-name">允许打赏</view>
            <view class="setting-desc">关闭后孩子将无法打赏打手</view>
          </view>
        </view>
        <switch
          checked="{{setting.allow_reward == 1}}"
          bindchange="onToggleReward"
          color="#4f8cff"
        />
      </view>

      <view class="setting-item danger-item">
        <view class="setting-info">
          <view class="setting-icon-bg freeze"></view>
          <view class="setting-main">
            <view class="setting-name">一键冻结账号</view>
            <view class="setting-desc">冻结后孩子无法下单、打赏、聊天</view>
          </view>
        </view>
        <switch
          checked="{{setting.is_frozen == 1}}"
          bindchange="onToggleFreeze"
          color="#f56c6c"
        />
      </view>
    </view>

    <view class="menu-card">
      <view class="menu-item" bindtap="onGoConsumeReport">
        <view class="menu-icon-bg report"></view>
        <view class="menu-text">
          <view class="menu-title">月度消费报告</view>
          <view class="menu-sub">查看订单明细、消费趋势</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-item" bindtap="onGoChatSummary">
        <view class="menu-icon-bg chat"></view>
        <view class="menu-text">
          <view class="menu-title">聊天记录摘要</view>
          <view class="menu-sub">敏感关键词、聊天频次（脱敏）</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
    </view>

    <view class="unbind-row">
      <button class="unbind-btn" bindtap="onUnbind">解除与{{currentChild.nickname || '该孩子'}}的监护绑定</button>
    </view>
  </view>
</view>
