<view class="join-page">
  <!-- 步骤指示器 -->
  <view class="step-indicator">
    <view class="step-bar">
      <view class="step-fill" style="width: {{step / totalSteps * 100}}%"></view>
    </view>
    <text class="step-text">步骤 {{step}} / {{totalSteps}}</text>
  </view>

  <!-- 草稿过期提示 -->
  <view class="draft-expired-tip" wx:if="{{draftExpired}}">
    <text>草稿已过期，请重新填写</text>
  </view>

  <!-- ====== 步骤1：入驻须知 ====== -->
  <view class="step-body" wx:if="{{step === 1}}">
    <view class="step-title">入驻须知</view>
    <view class="notice-content">
      <text class="notice-title">平台入驻规则</text>
      <text class="notice-text">1. 俱乐部入驻需通过平台人工审核，预计3个工作日内完成。</text>
      <text class="notice-text">2. 申请人须年满16周岁，需完成实名活体认证。</text>
      <text class="notice-text">3. 俱乐部名称一经审核通过不可修改，请慎重命名。</text>
      <text class="notice-text">4. 俱乐部将由系统自动生成唯一缩写，作为订单号前缀。</text>

      <text class="notice-title" style="margin-top: 20rpx;">保证金说明</text>
      <text class="notice-text" wx:if="{{isEnterprise}}">企业俱乐部保证金：{{enterpriseDeposit}} 元</text>
      <text class="notice-text" wx:else>个人俱乐部保证金：{{personalDeposit}} 元</text>
      <text class="notice-text">审核通过后缴纳保证金，俱乐部正式生效。</text>
    </view>

    <view class="agreement-section">
      <view class="agreement-item" bindtap="toggleAgree">
        <view class="checkbox {{agreed ? 'checked' : ''}}">
          <text wx:if="{{agreed}}">✓</text>
        </view>
        <text class="agreement-text">我已阅读并同意全部协议（入驻规则、合同、隐私政策）</text>
      </view>
    </view>
  </view>

  <!-- ====== 步骤2：基础资料 ====== -->
  <view class="step-body" wx:if="{{step === 2}}">
    <view class="step-title">基础资料</view>

    <view class="form-group">
      <view class="form-label">俱乐部名称</view>
      <input class="form-input" placeholder="请输入俱乐部中文名称（2-50字）" maxlength="50" value="{{clubName}}" bindinput="onClubNameInput" />
    </view>

    <!-- 缩写展示 -->
    <view class="abbr-section" wx:if="{{abbreviation}}">
      <view class="abbr-row">
        <text class="abbr-label">系统缩写：</text>
        <text class="abbr-value {{abbrOccupied ? 'occupied' : ''}}">{{abbreviation}}</text>
        <text class="abbr-status" wx:if="{{abbrOccupied}}">已被占用</text>
        <text class="abbr-status ok" wx:else>可用</text>
      </view>
      <view class="abbr-desc">订单号格式：{{abbreviation}}-年月日时分</view>
    </view>

    <!-- B2：缩写冲突推荐3套备选缩写 -->
    <view class="abbr-alternatives" wx:if="{{abbrAlternatives.length > 0}}">
      <view class="abbr-alt-title">缩写冲突，请选择以下备选缩写：</view>
      <view class="abbr-alt-list">
        <view
          class="abbr-alt-item"
          wx:for="{{abbrAlternatives}}"
          wx:key="*this"
          bindtap="onSelectAbbr"
          data-abbr="{{item}}"
        >{{item}}</view>
      </view>
    </view>

    <!-- 缩写占用弹窗 -->
    <view class="abbr-alert" wx:if="{{abbrOccupied && abbrAlternatives.length === 0}}">
      <text class="abbr-alert-title">检测到俱乐部缩写被占用，请更换俱乐部名称</text>
      <text class="abbr-alert-link" bindtap="onAbbrHelp">对缩写占用有疑惑？</text>
    </view>

    <view class="form-group">
      <view class="form-label">真实姓名</view>
      <input class="form-input" placeholder="请输入真实姓名" value="{{realName}}" bindinput="onInput" data-field="realName" />
    </view>
    <view class="form-group">
      <view class="form-label">身份证号码</view>
      <input class="form-input" type="idcard" placeholder="请输入18位身份证号码" maxlength="18" value="{{idCard}}" bindinput="onInput" data-field="idCard" />
      <!-- B5：年龄校验提示 -->
      <view class="form-tip required">须年满16周岁</view>
      <view class="form-tip" wx:if="{{idCardAge >= 0}}">
        <text wx:if="{{idCardAgeOk}}" class="tip-ok">当前年龄：{{idCardAge}}周岁，符合要求</text>
        <text wx:else class="tip-err">当前年龄：{{idCardAge}}周岁，未满16周岁不可入驻</text>
      </view>
    </view>
    <view class="form-group">
      <view class="form-label">手机号</view>
      <input class="form-input" type="number" placeholder="请输入本人实名手机号" maxlength="11" value="{{phone}}" bindinput="onInput" data-field="phone" />
    </view>

    <!-- B8：企业对公账户完整输入（提交时脱敏展示） -->
    <block wx:if="{{isEnterprise}}">
      <view class="form-group">
        <view class="form-label">企业名称</view>
        <input class="form-input" placeholder="请输入企业名称" value="{{enterpriseName}}" bindinput="onInput" data-field="enterpriseName" />
      </view>
      <view class="form-group">
        <view class="form-label">统一社会信用代码</view>
        <input class="form-input" placeholder="请输入统一社会信用代码" value="{{creditCode}}" bindinput="onInput" data-field="creditCode" />
      </view>
      <view class="form-group">
        <view class="form-label">对公账户开户银行</view>
        <input class="form-input" placeholder="请输入对公账户开户银行" value="{{corporateBank}}" bindinput="onInput" data-field="corporateBank" />
      </view>
      <view class="form-group">
        <view class="form-label">对公账户号 <text class="required-star">*</text></view>
        <input class="form-input" type="number" placeholder="请输入完整对公账户号" value="{{corporateAccount}}" bindinput="onInput" data-field="corporateAccount" />
        <view class="form-tip" wx:if="{{corporateAccountMasked}}">提交后将以下列脱敏形式展示：{{corporateAccountMasked}}</view>
      </view>
      <view class="upload-group">
        <view class="upload-label">营业执照</view>
        <view class="upload-box" bindtap="onUploadImage" data-field="businessLicense">
          <image wx:if="{{businessLicense}}" class="upload-preview" src="{{businessLicense}}" mode="aspectFit" />
          <text wx:else class="upload-placeholder">+ 点击上传</text>
        </view>
      </view>
    </block>

    <!-- B3：地址7字段（全部必填，标红*） -->
    <view class="form-group">
      <view class="form-label">详细地址 <text class="required-star">*</text> <text class="form-tip required">（以下7项均为必填，缺少任意一项将无法提交）</text></view>
      <input class="form-input" placeholder="省 *" value="{{addressProvince}}" bindinput="onInput" data-field="addressProvince" />
      <input class="form-input" placeholder="市 *" value="{{addressCity}}" bindinput="onInput" data-field="addressCity" />
      <input class="form-input" placeholder="区/县 *" value="{{addressDistrict}}" bindinput="onInput" data-field="addressDistrict" />
      <input class="form-input" placeholder="乡镇/街道 *" value="{{addressStreet}}" bindinput="onInput" data-field="addressStreet" />
      <input class="form-input" placeholder="小区 *" value="{{addressCommunity}}" bindinput="onInput" data-field="addressCommunity" />
      <input class="form-input" placeholder="楼栋 *" value="{{addressBuilding}}" bindinput="onInput" data-field="addressBuilding" />
      <input class="form-input" placeholder="户号 *" value="{{addressHouseNo}}" bindinput="onInput" data-field="addressHouseNo" />
      <view class="form-tip" wx:if="{{!addressComplete}}">请补全所有地址字段后再继续</view>
      <view class="form-tip tip-ok" wx:else>地址信息已完整</view>
    </view>
  </view>

  <!-- ====== 步骤3：活体认证 ====== -->
  <view class="step-body" wx:if="{{step === 3}}">
    <view class="step-title">实名活体认证</view>

    <view class="upload-group">
      <view class="upload-label">身份证正面</view>
      <view class="upload-box" bindtap="onUploadImage" data-field="idCardFront">
        <image wx:if="{{idCardFront}}" class="upload-preview" src="{{idCardFront}}" mode="aspectFit" />
        <text wx:else class="upload-placeholder">+ 点击上传</text>
      </view>
    </view>
    <view class="upload-group">
      <view class="upload-label">身份证反面</view>
      <view class="upload-box" bindtap="onUploadImage" data-field="idCardBack">
        <image wx:if="{{idCardBack}}" class="upload-preview" src="{{idCardBack}}" mode="aspectFit" />
        <text wx:else class="upload-placeholder">+ 点击上传</text>
      </view>
    </view>

    <!-- 活体认证收费说明(合规告知) -->
    <view class="fee-notice">
      <view class="fee-notice-header">
        <text class="fee-notice-icon">ℹ</text>
        <text class="fee-notice-title">活体认证收费说明</text>
      </view>
      <view class="fee-notice-body">
        <view class="fee-row">
          <text class="fee-label">收费标准</text>
          <text class="fee-value">每次 ¥2.00</text>
        </view>
        <view class="fee-row">
          <text class="fee-label">收费方式</text>
          <text class="fee-value">先收费后认证，认证失败不退款</text>
        </view>
        <view class="fee-row">
          <text class="fee-label">收费依据</text>
          <text class="fee-value">第三方人脸识别服务按调用次数计费</text>
        </view>
      </view>
      <view class="fee-agree" bindtap="toggleFeeAgree">
        <view class="checkbox {{feeAgreed ? 'checked' : ''}}">
          <text wx:if="{{feeAgreed}}">✓</text>
        </view>
        <text class="fee-agree-text">我已知晓并同意上述收费规则，点击开始识别即从余额扣除 ¥2.00</text>
      </view>
    </view>

    <view class="liveness-section">
      <view class="liveness-label">活体人脸识别</view>
      <button class="liveness-btn" bindtap="onLivenessCheck" wx:if="{{livenessStatus === 0}}" disabled="{{!feeAgreed}}">开始人脸识别</button>
      <view class="liveness-passed" wx:if="{{livenessStatus === 1}}">已通过人脸识别</view>
    </view>
  </view>

  <!-- ====== 步骤4：合同上传 ====== -->
  <view class="step-body" wx:if="{{step === 4}}">
    <view class="step-title">入驻合同</view>

    <view class="contract-section">
      <button class="contract-btn download" bindtap="onDownloadTemplate">下载{{isEnterprise ? '企业版' : '个人版'}}入驻PDF合同</button>
      <text class="contract-hint">请下载打印、手写签名、按手印{{isEnterprise ? '、加盖企业公章' : ''}}，扫描为PDF文件上传</text>
      <!-- B9：合同盖章提示 -->
      <view class="contract-stamp-tip">请确保合同已加盖公章并有法人签字，未盖章合同将被审核驳回</view>
    </view>

    <view class="upload-group">
      <view class="upload-label">上传已签署合同</view>
      <view class="upload-box file" bindtap="onUploadContract">
        <text wx:if="{{contractFile}}" class="upload-file-name">{{contractFile}}</text>
        <text wx:else class="upload-placeholder">+ 点击上传PDF文件</text>
      </view>
      <view class="upload-actions" wx:if="{{contractFile}}">
        <text class="action-link" bindtap="onPreviewContract">预览合同</text>
        <text class="action-link" bindtap="onUploadContract">重新上传</text>
      </view>
      <view class="form-tip tip-ok" wx:if="{{contractPdfValid}}">PDF校验通过</view>
    </view>

    <!-- 企业专属：代办合同 -->
    <block wx:if="{{isEnterprise}}">
      <view class="form-group">
        <view class="form-label">办理方式</view>
        <view class="radio-row">
          <view class="radio-item {{handleType === 'self' ? 'active' : ''}}" bindtap="onSelectHandleType" data-value="self">法人本人办理</view>
          <view class="radio-item {{handleType === 'agent' ? 'active' : ''}}" bindtap="onSelectHandleType" data-value="agent">代办人办理</view>
        </view>
      </view>

      <!-- B7：代办模式下必须上传代办合同PDF -->
      <block wx:if="{{handleType === 'agent'}}">
        <view class="upload-group">
          <view class="upload-label">代办合同PDF <text class="required-star">*</text></view>
          <view class="upload-box file" bindtap="onUploadAgentAuth">
            <text wx:if="{{agentAuthorization}}" class="upload-file-name">{{agentAuthorization}}</text>
            <text wx:else class="upload-placeholder">+ 点击上传代办合同PDF</text>
          </view>
          <view class="form-tip tip-ok" wx:if="{{agentAuthPdfValid}}">代办合同PDF校验通过</view>
          <view class="form-tip required" wx:else>未上传代办合同PDF，无法进入下一步</view>
        </view>

        <view class="form-group">
          <view class="form-label">代办人姓名</view>
          <input class="form-input" placeholder="请输入代办人姓名" value="{{agentName}}" bindinput="onInput" data-field="agentName" />
        </view>
        <view class="form-group">
          <view class="form-label">代办人身份证号</view>
          <input class="form-input" type="idcard" placeholder="请输入代办人身份证号" maxlength="18" value="{{agentIdCard}}" bindinput="onInput" data-field="agentIdCard" />
        </view>
        <view class="upload-group">
          <view class="upload-label">代办人身份证正面</view>
          <view class="upload-box" bindtap="onUploadImage" data-field="agentIdCardFront">
            <image wx:if="{{agentIdCardFront}}" class="upload-preview" src="{{agentIdCardFront}}" mode="aspectFit" />
            <text wx:else class="upload-placeholder">+ 点击上传</text>
          </view>
        </view>
        <view class="upload-group">
          <view class="upload-label">代办人身份证反面</view>
          <view class="upload-box" bindtap="onUploadImage" data-field="agentIdCardBack">
            <image wx:if="{{agentIdCardBack}}" class="upload-preview" src="{{agentIdCardBack}}" mode="aspectFit" />
            <text wx:else class="upload-placeholder">+ 点击上传</text>
          </view>
        </view>
      </block>
    </block>
  </view>

  <!-- ====== 步骤5：预览 ====== -->
  <view class="step-body" wx:if="{{step === 5}}">
    <view class="step-title">资料预览确认</view>

    <view class="preview-section">
      <view class="preview-item">
        <text class="preview-label">俱乐部名称</text>
        <text class="preview-value">{{clubName}}</text>
      </view>
      <view class="preview-item">
        <text class="preview-label">系统缩写</text>
        <text class="preview-value">{{abbreviation}}</text>
      </view>
      <view class="preview-item">
        <text class="preview-label">姓名</text>
        <text class="preview-value">{{realName}}</text>
      </view>
      <view class="preview-item">
        <text class="preview-label">身份证</text>
        <text class="preview-value">{{idCard}}</text>
      </view>
      <view class="preview-item">
        <text class="preview-label">手机号</text>
        <text class="preview-value">{{phone}}</text>
      </view>
      <view class="preview-item">
        <text class="preview-label">地址</text>
        <text class="preview-value">{{addressProvince}}{{addressCity}}{{addressDistrict}}{{addressStreet}}{{addressCommunity}}{{addressBuilding}}{{addressHouseNo}}</text>
      </view>
      <!-- B8：企业对公账户脱敏展示 -->
      <block wx:if="{{isEnterprise}}">
        <view class="preview-item">
          <text class="preview-label">对公账户银行</text>
          <text class="preview-value">{{corporateBank}}</text>
        </view>
        <view class="preview-item">
          <text class="preview-label">对公账户号</text>
          <text class="preview-value">{{corporateAccountMasked}}</text>
        </view>
      </block>
      <view class="preview-item">
        <text class="preview-label">保证金</text>
        <text class="preview-value">{{isEnterprise ? enterpriseDeposit : personalDeposit}} 元</text>
      </view>
    </view>

    <view class="preview-submit">
      <button class="submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
        确认提交入驻申请
      </button>
    </view>
  </view>

  <!-- 底部导航按钮 -->
  <view class="step-footer">
    <button class="footer-btn prev" wx:if="{{step > 1}}" bindtap="prevStep">上一步</button>
    <!-- B3/B7：缺少必填项时置灰下一步按钮（nextStep 内会做完整校验并 toast 拦截） -->
    <button
      class="footer-btn next {{(step === 2 && (!addressComplete || !idCardAgeOk)) || (step === 4 && isEnterprise && handleType === 'agent' && !agentAuthPdfValid) ? 'disabled' : ''}}"
      wx:if="{{step < 5}}"
      bindtap="nextStep">下一步</button>
  </view>
</view>
