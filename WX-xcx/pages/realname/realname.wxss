}
.gb-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.gb-icon {
  font-size: 26rpx;
}
.gb-title {
  color: #fecaca;
  font-size: 26rpx;
  font-weight: 700;
}
.gb-desc {
  display: block;
  color: #fca5a5;
  font-size: 22rpx;
  line-height: 1.6;
  margin-bottom: 12rpx;
}
.gb-btn {
  width: 100%;
  height: 80rpx;
