  font-family: "DIN Alternate", sans-serif;
}
.mc-num.gold { color: #f59e0b; }
.mc-num.warn { color: #ef4444; }
.mc-title {
  margin-top: 4rpx;
  color: #cbd5e1;
  font-size: 22rpx;
  font-weight: 600;
}
.mc-val {
