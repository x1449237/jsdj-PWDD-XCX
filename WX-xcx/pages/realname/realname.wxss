.mc-desc {
  margin-top: 4rpx;
  color: #64748b;
  font-size: 18rpx;
}

.guardian-box {
  margin: 8rpx 0 16rpx;
  padding: 20rpx;
  background: rgba(239, 68, 68, 0.08);
  border: 2rpx solid rgba(239, 68, 68, 0.35);
