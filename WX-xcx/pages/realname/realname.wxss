.mh-icon {
  font-size: 30rpx;
}
.minor-title {
  color: #fcd34d;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.minor-body {
  padding: 24rpx 28rpx 12rpx;
}
.minor-lead {
