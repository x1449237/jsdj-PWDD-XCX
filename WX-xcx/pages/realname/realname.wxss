/* =============================================
   戟三电竞 · 实名认证 页面样式
   目标: 主流简洁小程序风格，有品牌辨识度但不科幻
   配色: #0F172A 靛青深蓝主背景 / #F59E0B 戟金橙 主色
         #1E293B 卡片 / #94A3B8 次文字 / #CBD5E1 主文字
   ============================================= */

.realname-page {
  min-height: 100vh;
  background: #0B1120;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

/* ========== 顶部导航 ========== */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #0F172A;
}
.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(148, 163, 184, 0.12);
}
.back-icon {
  color: #E2E8F0;
  font-size: 40rpx;
  line-height: 1;
  margin-left: -4rpx;
}
.top-title {
  color: #F1F5F9;
  font-size: 32rpx;
  font-weight: 600;
}
.top-right {
  padding: 0 8rpx;
}
.help-text {
  color: #64748B;
  font-size: 26rpx;
}

/* ========== 顶部说明条 ========== */
.notice-bar {
  display: flex;
  align-items: flex-start;
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  background: rgba(56, 189, 248, 0.08);
  border: 2rpx solid rgba(56, 189, 248, 0.2);
  border-radius: 12rpx;
}
.notice-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #38BDF8;
  margin-top: 10rpx;
  margin-right: 12rpx;
}
.notice-bar text:last-child {
  flex: 1;
  color: #94A3B8;
  font-size: 24rpx;
  line-height: 1.65;
}

/* ========== 通用卡片 ========== */
.main-card {
  margin: 20rpx 24rpx 0;
  padding: 28rpx 24rpx;
  background: #111827;
  border: 2rpx solid rgba(30, 41, 59, 0.6);
  border-radius: 16rpx;
}
.main-card.fee-card {
  background:
    linear-gradient(180deg, rgba(16, 185, 129, 0.04) 0%, transparent 60%),
    #111827;
  border-color: rgba(16, 185, 129, 0.22);
}

/* 卡片标题 */
.card-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.title-line {
  width: 6rpx;
  height: 28rpx;
  background: #38BDF8;
  border-radius: 3rpx;
  margin-right: 14rpx;
}
.title-line.gold {
  background: #F59E0B;
}
.title-text {
  flex: 1;
  color: #E2E8F0;
  font-size: 30rpx;
  font-weight: 600;
}
.title-num {
  color: #64748B;
  font-size: 24rpx;
  font-family: "DIN Alternate", sans-serif;
  font-weight: 600;
}
.title-num.gold {
  color: #F59E0B;
}

/* ========== 头部卡: 价格 + 进度 + 步骤 ========== */
.head-card {
  padding-top: 24rpx;
}
.head-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.price-block {
  flex: 1;
  min-width: 0;
}
.price-label {
  display: block;
  color: #94A3B8;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}
.price-num {
  display: flex;
  align-items: baseline;
  line-height: 1;
}
.price-sym {
  color: #F59E0B;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 2rpx;
}
.price-whole {
  color: #F59E0B;
  font-size: 56rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.price-dec {
  color: #F59E0B;
  font-size: 28rpx;
  font-weight: 600;
  font-family: "DIN Alternate", sans-serif;
}
.price-unit {
  margin-left: 8rpx;
  color: #64748B;
  font-size: 24rpx;
}
.price-desc {
  display: block;
  margin-top: 10rpx;
  color: #64748B;
  font-size: 22rpx;
}
.l3-tag {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  background: rgba(245, 158, 11, 0.1);
  border: 2rpx solid rgba(245, 158, 11, 0.4);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.l3-num {
  color: #F59E0B;
  font-size: 34rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
  line-height: 1;
}
.l3-name {
  color: #94A3B8;
  font-size: 20rpx;
  margin-top: 6rpx;
}

/* 进度条 */
.head-progress-wrap {
  margin-bottom: 24rpx;
}
.progress-bar {
  width: 100%;
  height: 10rpx;
  background: rgba(100, 116, 139, 0.2);
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #38BDF8 0%, #F59E0B 100%);
  border-radius: 6rpx;
  transition: width 0.35s ease;
}
.progress-text {
  display: block;
  margin-top: 10rpx;
  color: #64748B;
  font-size: 22rpx;
}

/* 步骤条 */
.step-bar {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 2;
}
.step-circle {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #1E293B;
  border: 2rpx solid rgba(100, 116, 139, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748B;
}
.step.active .step-circle {
  background: rgba(56, 189, 248, 0.15);
  border-color: #38BDF8;
  color: #7DD3FC;
}
.step.done .step-circle {
  background: #10B981;
  border-color: #10B981;
}
.step.done .ok-mark {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}
.step-n {
  font-size: 24rpx;
  font-weight: 600;
  font-family: "DIN Alternate", sans-serif;
}
.step-circle.pay {
  background: rgba(245, 158, 11, 0.12);
  border-color: rgba(245, 158, 11, 0.6);
  color: #F59E0B;
}
.step-t {
  margin-top: 10rpx;
  color: #64748B;
  font-size: 22rpx;
}
.step.active .step-t {
  color: #E2E8F0;
  font-weight: 500;
}
.step.done .step-t {
  color: #10B981;
  font-weight: 500;
}
.step-t.pay {
  color: #F59E0B;
}
.step-line {
  flex: 1;
  height: 2rpx;
  margin: 0 8rpx 26rpx;
  background: rgba(100, 116, 139, 0.3);
}
.step-line.done {
  background: #10B981;
}

/* ========== 证件上传 ========== */
.upload-area {
  position: relative;
  background: #0B1120;
  border: 2rpx dashed rgba(100, 116, 139, 0.35);
  border-radius: 12rpx;
  height: 340rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
  transition: border-color 0.2s;
}
.upload-area:active {
  border-color: rgba(56, 189, 248, 0.6);
}
.uploaded-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}
.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0 24rpx;
  width: 100%;
  box-sizing: border-box;
}
.ph-icon-wrap {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.ph-circle {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(56, 189, 248, 0.5);
  opacity: 0.6;
}
.ph-icon-wrap::before {
  content: " ";
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(56, 189, 248, 0.15);
  position: relative;
  z-index: 2;
  display: block;
}
.ph-icon-wrap.bk .ph-circle {
  border-color: rgba(245, 158, 11, 0.5);
}
.ph-icon-wrap.bk::before {
  background: rgba(245, 158, 11, 0.15);
}
.ph-main {
  color: #E2E8F0;
  font-size: 30rpx;
  font-weight: 600;
}
.ph-sub {
  color: #64748B;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.5;
}
.ph-btn {
  margin-top: 8rpx;
  padding: 10rpx 24rpx;
  background: rgba(56, 189, 248, 0.1);
  border: 2rpx solid rgba(56, 189, 248, 0.35);
  border-radius: 8rpx;
  color: #7DD3FC;
  font-size: 24rpx;
}
.ph-btn.bk {
  background: rgba(245, 158, 11, 0.1);
  border-color: rgba(245, 158, 11, 0.4);
  color: #FCD34D;
}
.upload-ok-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 14rpx;
  background: rgba(16, 185, 129, 0.92);
  color: #fff;
  font-size: 22rpx;
  border-radius: 6rpx;
  font-weight: 500;
}
.upload-ok-tag.bk {
  background: rgba(245, 158, 11, 0.92);
}

/* 上传中间分隔 */
.divider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 18rpx 0;
}
.div-line {
  flex: 1;
  height: 2rpx;
  background: rgba(100, 116, 139, 0.2);
}
.div-text {
  color: #64748B;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

/* 上传提示 */
.tips-list {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(30, 41, 59, 0.5);
  border-radius: 10rpx;
}
.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}
.tip-item:last-child { margin-bottom: 0; }
.ti-dot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: 8rpx;
  margin-right: 12rpx;
  background: #64748B;
}
.ti-dot.ok {
  background: #10B981;
}
.ti-dot.warn {
  background: #F59E0B;
}
.tip-item text:last-child {
  flex: 1;
  color: #94A3B8;
  font-size: 24rpx;
  line-height: 1.5;
}
.tip-item.warn text:last-child {
  color: #FCD34D;
}

/* ========== 表单 ========== */
.form-group {
  margin-bottom: 22rpx;
}
.form-group:last-child {
  margin-bottom: 0;
}
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
  padding: 0 4rpx;
}
.label-block {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}
.label-required {
  color: #EF4444;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 4rpx;
}
.label-text {
  color: #CBD5E1;
  font-size: 26rpx;
  font-weight: 500;
}
.label-text.small {
  font-size: 24rpx;
}
.label-hint {
  color: #64748B;
  font-size: 22rpx;
  margin-left: 10rpx;
}
.label-hint.mono {
  font-family: Menlo, Consolas, monospace;
  color: #7DD3FC;
}
.picker-row {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  background: #0B1120;
  border: 2rpx solid rgba(100, 116, 139, 0.25);
  border-radius: 10rpx;
  box-sizing: border-box;
}
.picker-value {
  color: #E2E8F0;
  font-size: 28rpx;
}
.picker-value.ph {
  color: #475569;
}
.picker-arrow {
  color: #64748B;
  font-size: 32rpx;
  line-height: 1;
  margin-left: 10rpx;
}

/* 输入框 */
.form-input-row {
  height: 92rpx;
  padding: 0 24rpx;
  background: #0B1120;
  border: 2rpx solid rgba(100, 116, 139, 0.25);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.form-input-row.error {
  border-color: rgba(239, 68, 68, 0.6);
  background: rgba(239, 68, 68, 0.04);
}
.form-input {
  width: 100%;
  height: 100%;
  color: #E2E8F0;
  font-size: 28rpx;
}
.form-input.mono {
  font-family: Menlo, Consolas, monospace;
  letter-spacing: 1rpx;
}
.input-ph {
  color: #475569;
}

.err-row {
  margin-top: 8rpx;
  padding: 10rpx 16rpx;
  display: flex;
  align-items: flex-start;
  background: rgba(239, 68, 68, 0.06);
  border: 2rpx solid rgba(239, 68, 68, 0.25);
  border-radius: 8rpx;
}
.err-mark {
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #EF4444;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
  margin-right: 12rpx;
}
.err-text {
  flex: 1;
  color: #FCA5A5;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 日期并排 */
.date-row {
  display: flex;
  gap: 16rpx;
  margin-top: 4rpx;
}
.form-group.half {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}
.date-box {
  height: 88rpx;
  padding: 0 20rpx;
  background: #0B1120;
  border: 2rpx solid rgba(100, 116, 139, 0.25);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #E2E8F0;
  font-size: 26rpx;
  box-sizing: border-box;
}
.date-box .ph {
  color: #475569;
}
.perm-box {
  height: 88rpx;
  padding: 0 20rpx;
  background: rgba(16, 185, 129, 0.08);
  border: 2rpx solid rgba(16, 185, 129, 0.35);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  color: #34D399;
  font-size: 26rpx;
  font-weight: 500;
  box-sizing: border-box;
}

/* ========== 合规收费说明 ========== */
.fee-head {
  margin-bottom: 20rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx dashed rgba(100, 116, 139, 0.25);
}
.fee-head-left {
  display: flex;
  align-items: center;
}
.fee-title-icon {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  margin-right: 14rpx;
  position: relative;
}
.fee-title-icon::after {
  content: "";
  position: absolute;
  inset: 14rpx;
  border: 4rpx solid #fff;
  border-top: none;
  border-right: none;
  border-radius: 0 0 0 4rpx;
  transform: rotate(-45deg) translate(6rpx, -6rpx);
}
.fee-title {
  display: block;
  color: #E2E8F0;
  font-size: 30rpx;
  font-weight: 600;
}
.fee-sub {
  display: block;
  margin-top: 4rpx;
  color: #64748B;
  font-size: 22rpx;
}
.fee-list {
  margin-bottom: 20rpx;
}
.fee-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 2rpx dashed rgba(100, 116, 139, 0.18);
}
.fee-item:last-child {
  border-bottom: none;
}
.fi-no {
  flex-shrink: 0;
  width: 52rpx;
  color: #38BDF8;
  font-size: 24rpx;
  font-family: "DIN Alternate", sans-serif;
  font-weight: 600;
  padding-top: 2rpx;
}
.fi-no.warn {
  color: #EF4444;
}
.fi-body {
  flex: 1;
  min-width: 0;
}
.fi-k {
  display: block;
  color: #94A3B8;
  font-size: 22rpx;
  margin-bottom: 4rpx;
}
.fi-k.warn {
  color: #FCA5A5;
}
.fi-v {
  display: block;
  color: #CBD5E1;
  font-size: 26rpx;
  line-height: 1.55;
}
.fi-v.gold {
  color: #FCD34D;
  font-weight: 600;
}
.fi-v.warn {
  color: #FECACA;
}

.third-party-tip {
  padding: 16rpx 18rpx;
  background: rgba(56, 189, 248, 0.06);
  border-left: 6rpx solid rgba(56, 189, 248, 0.5);
  border-radius: 4rpx;
}
.tp-tag {
  display: block;
  color: #7DD3FC;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.tp-text {
  display: block;
  color: #94A3B8;
  font-size: 22rpx;
  line-height: 1.7;
}

/* ========== 提交区 ========== */
.submit-wrap {
  margin: 32rpx 24rpx 0;
}
.agree-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}
.agree-box {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(100, 116, 139, 0.6);
  background: #111827;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  margin-top: 4rpx;
  transition: all 0.2s;
}
.agree-box.on {
  background: #F59E0B;
  border-color: #F59E0B;
}
.agree-ok {
  color: #0B1120;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}
.agree-text {
  flex: 1;
  min-width: 0;
  color: #94A3B8;
  font-size: 24rpx;
  line-height: 1.7;
}
.link-blue {
  color: #38BDF8;
}
.link-gold {
  color: #FCD34D;
  font-weight: 500;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0;
  background: linear-gradient(90deg, #F59E0B 0%, #D97706 100%);
  color: #0B1120;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(245, 158, 11, 0.28);
}
.submit-btn::after {
  border: none;
}
.submit-btn.disabled {
  background: #334155;
  color: #94A3B8;
  box-shadow: none;
}

.support-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.sp-item, .sp-dot {
  color: #475569;
  font-size: 22rpx;
}

/* ========== 弹层 ========== */
.modal {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mask {
  position: absolute;
  inset: 0;
  background: rgba(2, 6, 23, 0.88);
}
.modal-body {
  position: relative;
  width: 620rpx;
  background: #111827;
  border: 2rpx solid rgba(30, 41, 59, 0.8);
  border-radius: 20rpx;
  padding: 32rpx 28rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.7);
}

/* 活体弹层 */
.mb-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.mbt-text {
  color: #E2E8F0;
  font-size: 32rpx;
  font-weight: 600;
}
.mbt-status {
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  background: rgba(100, 116, 139, 0.2);
  color: #94A3B8;
  font-size: 22rpx;
  font-weight: 500;
}
.mbt-status.scanning {
  background: rgba(245, 158, 11, 0.12);
  color: #FCD34D;
}
.mbt-status.success {
  background: rgba(16, 185, 129, 0.12);
  color: #34D399;
}
.mbt-status.fail {
  background: rgba(239, 68, 68, 0.12);
  color: #FCA5A5;
}

.live-scanner {
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.live-idle, .live-scan, .live-res {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.face-circle {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: #0B1120;
  border: 4rpx solid rgba(148, 163, 184, 0.4);
  margin-bottom: 20rpx;
}
.scan-box {
  position: relative;
  width: 260rpx;
  height: 260rpx;
  margin-bottom: 20rpx;
}
.scan-box .face-circle {
  position: absolute;
  inset: 0;
  margin: 0;
  border-color: rgba(245, 158, 11, 0.6);
}
.scan-line {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  top: 20%;
  height: 4rpx;
  background: linear-gradient(90deg, transparent 0%, #F59E0B 50%, transparent 100%);
  border-radius: 4rpx;
  box-shadow: 0 0 14rpx rgba(245, 158, 11, 0.6);
  animation: scanVert 1.3s ease-in-out infinite;
}
@keyframes scanVert {
  0% { top: 18%; }
  50% { top: 82%; }
  100% { top: 18%; }
}
