<view class="pims">
  <!-- 三、搜索精细化 21-26 -->
  <view class="search-bar">
    <view class="search-wrap">
      <input class="search-input" placeholder="搜索订单号/俱乐部/昵称/聊天关键词" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search" />
      <text class="search-btn" bindtap="onSearchConfirm">搜索</text>
    </view>
    <view class="history" wx:if="{{history.length>0}}">
      <view class="h-label">历史搜索：</view>
      <view class="h-items">
        <text wx:for="{{history}}" wx:key="*this" class="h-tag" data-k="{{item}}" bindtap="onHistoryClick">{{item}}</text>
      </view>
      <text class="h-clear" bindtap="onHistoryClear">清空</text>
    </view>
  </view>

  <!-- 二、顶部多条件筛选 11-20 -->
  <scroll-view scroll-x="true" class="tabs">
    <view class="tab-item {{tab===item.key?'active':''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="onTabClick">
      {{item.name}}
    </view>
  </scroll-view>
  <view class="sub-filter">
    <view class="sf-item {{timeRange==='yesterday'?'active':''}}" data-v="yesterday" bindtap="onTimeRange">昨天</view>
    <view class="sf-item {{timeRange==='3d'?'active':''}}" data-v="3d" bindtap="onTimeRange">近3天</view>
    <view class="sf-item {{timeRange==='7d'?'active':''}}" data-v="7d" bindtap="onTimeRange">近7天</view>
    <view class="sf-item" bindtap="onOpenTagFilter">按标签筛选{{tagID?' ✓':''}}</view>
    <view class="sf-item" wx:if="{{tagID}}" bindtap="onClearTagFilter">清除标签</view>
    <view class="sf-item {{onlyStarred?'active':''}}" bindtap="onStarSwitch">⭐稍后处理</view>
    <view class="sf-item" bindtap="onBatchMute">🔕批量免打扰</view>
  </view>
  <view class="sub-filter">
    <input class="sf-input" placeholder="俱乐部名称/缩写筛选" value="{{clubKeyword}}" bindinput="onClubInput" bindblur="onClubBlur" />
    <input class="sf-input" type="number" placeholder="游戏品类ID" value="{{gameID}}" bindchange="onGameChange" />
  </view>

  <!-- 一、会话自动优先级分组 + 沉寂折叠 + 星标 -->
  <block wx:for="{{groups}}" wx:key="bucketKey" wx:for-item="g">
    <view class="group-wrap">
      <view class="group-head" data-k="{{g.bucketKey}}" bindtap="onToggleBucket">
        <text class="arrow {{g.isCollapsed?'collapsed':''}}">▼</text>
        <text class="group-name">{{g.bucket_name}}</text>
        <text class="group-count">{{g.items.length}}条</text>
        <text class="group-collapse" wx:if="{{g.is_collapsed}}" style="color:#909399;">（默认折叠）</text>
      </view>
      <block wx:if="{{!g.isCollapsed}}">
        <view wx:if="{{g.items.length===0}}" class="empty">分组为空</view>
        <view wx:for="{{g.items}}" wx:key="session_id" wx:for-item="s" class="sess-item" data-id="{{s.session_id}}" bindtap="onOpenSession">
          <!-- 风险/置顶色边 -->
          <view wx:if="{{s.risk_flag>=2}}" class="sess-side {{s.riskCls}}"></view>
          <view class="sess-avatar">
            <!-- 十、头像框占位 (样式从 styles/me 拉取后动态设置,此处仅结构) -->
            <view class="avatar-wrap">
              <image class="avatar" src="{{s.sender_avatar || '/assets/icons/default-avatar.png'}}" mode="aspectFill" />
            </view>
            <view wx:if="{{s.unreadDisplay}}" class="badge {{s.unread_bold?'b-bold':''}}">{{s.unreadDisplay}}</view>
          </view>
          <view class="sess-main">
            <view class="sess-top">
              <text class="sess-title">{{s.title}}</text>
              <text wx:if="{{s.horn_flag}}" class="horn">📣</text>
              <text class="sess-time">{{s.last_msg_at}}</text>
            </view>
            <view class="sess-sub">
              <text wx:if="{{s.official_badge}}" class="badge-ib" style="background:{{s.official_badge_color}};color:#fff;">{{s.official_badge}}</text>
              <text wx:if="{{s.group_label}}" class="badge-ib bg-gray">{{s.group_label}}</text>
              <text class="risk-label {{s.riskCls}}" wx:if="{{s.riskLabel}}">{{s.riskLabel}}</text>
            </view>
            <view class="sess-msg">
              <text>{{s.sub_title}}</text>
            </view>
            <view class="sess-last">
              <text class="last-preview">{{s.last_msg_preview}}</text>
              <text wx:if="{{s.my_note_preview}}" class="note-preview">📝{{s.my_note_preview}}</text>
            </view>
            <!-- 四、标签色块 29 -->
            <view class="sess-tags" wx:if="{{s.tags.length>0}}">
              <text wx:for="{{s.tags}}" wx:key="tag_id" wx:for-item="t" class="tag" style="background:{{t.tag_color}};">{{t.tag_name}}</text>
            </view>
          </view>
          <view class="sess-opt">
            <view class="opt" catchtap="onToggleStar" data-id="{{s.session_id}}">{{s.star_flag===1?'⭐':'☆'}}</view>
            <view class="opt" catchtap="onQuickTag" data-id="{{s.session_id}}">🏷</view>
            <view class="opt" catchtap="onMarkDone" data-id="{{s.session_id}}">✓</view>
          </view>
        </view>
      </block>
    </view>
  </block>
</view>
