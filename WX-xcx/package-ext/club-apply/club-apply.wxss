.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.tab-bar {
  display: flex;
  background-color: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #e94560;
  font-weight: bold;
}

.tab-item.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 48rpx;
  height: 4rpx;
  background-color: #e94560;
  border-radius: 2rpx;
  transform: translateX(-50%);
}

.form-card {
  margin: 16rpx 24rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.picker-text {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333333;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.picker-text.placeholder {
  color: #999999;
}
