<view class="message-item {{extraClass}}" data-mid="{{message.id}}" bindlongpress="onLongPress">
  <!-- 系统消息 -->
  <view wx:if="{{message.type === 'system'}}" class="message-system">
    <text class="system-text text-xs text-tip">{{message.content}}</text>
  </view>

  <!-- 自己发送的消息 -->
  <view wx:elif="{{message.isSelf}}" class="message-self">
    <view class="message-bubble-wrapper">
      <view wx:if="{{message.senderRoleKey==='platform' || message.officialTag}}" class="name-row name-right">
        <text wx:if="{{message.officialTag}}" class="official-tag">{{message.officialTag}}</text>
        <text class="sn">{{message.senderName}}</text>
        <text wx:if="{{message.vBadgeType}}" class="v-badge" style="font-size:{{message.officialVSize||24}}rpx;">{{message.vBadgeType}}</text>
      </view>

      <view class="bubble-row">
        <view wx:if="{{message.verticalMark}}" class="vm-line"></view>
        <view class="message-bubble bubble-self" style="{{bubbleStyleStr}}">
          <text wx:if="{{message.type === 'text'}}" class="bubble-text" style="{{textStyleStr}}">{{message.content}}</text>
          <view wx:if="{{message.type === 'voice'}}" class="bubble-voice" bindtap="onPlayVoice">
            <text class="voice-icon">🔊</text>
            <text class="voice-duration">{{message.voiceDuration}}″</text>
            <view class="voice-waves">
              <view class="voice-wave {{playing?'playing':''}}" wx:for="{{4}}" wx:key="index" style="{{voiceWaveStr}}"></view>
            </view>
          </view>
          <image wx:if="{{message.type === 'image'}}" class="bubble-image" src="{{message.imageUrl}}" mode="aspectFill" bindtap="onPreviewImage"></image>
        </view>
      </view>

      <view class="message-meta">
        <text wx:if="{{message.isRead}}" class="meta-read text-xs text-success">已读</text>
        <text wx:else class="meta-read text-xs text-tip">未读</text>
        <text class="meta-time text-xs text-tip">{{message.time}}</text>
      </view>
    </view>
    <view class="avatar-frame" style="{{avatarFrameStr}}">
      <image class="message-avatar" src="{{message.avatar}}" mode="aspectFill"></image>
    </view>
  </view>

  <!-- 对方发送的消息 -->
  <view wx:else class="message-other">
    <view class="avatar-frame" style="{{avatarFrameStr}}">
      <image class="message-avatar" src="{{message.avatar}}" mode="aspectFill"></image>
    </view>

    <view class="message-bubble-wrapper">
      <view wx:if="{{message.senderRoleKey==='platform' || message.officialTag || message.vBadgeType}}" class="name-row">
        <text wx:if="{{message.officialTag}}" class="official-tag">{{message.officialTag}}</text>
        <text class="sn">{{message.senderName}}</text>
        <text wx:if="{{message.vBadgeType}}" class="v-badge" style="font-size:{{message.officialVSize||24}}rpx;">{{message.vBadgeType}}</text>
      </view>
      <view class="bubble-row">
        <view wx:if="{{message.verticalMark}}" class="vm-line"></view>
        <view class="message-bubble bubble-other" style="{{bubbleStyleStr}}">
          <text wx:if="{{message.type === 'text'}}" class="bubble-text" style="{{textStyleStr}}">{{message.content}}</text>
          <view wx:if="{{message.type === 'voice'}}" class="bubble-voice" bindtap="onPlayVoice">
            <text class="voice-icon">🔊</text>
            <text class="voice-duration">{{message.voiceDuration}}″</text>
            <view class="voice-waves">
              <view class="voice-wave {{playing?'playing':''}}" wx:for="{{4}}" wx:key="index" style="{{voiceWaveStr}}"></view>
            </view>
          </view>
          <image wx:if="{{message.type === 'image'}}" class="bubble-image" src="{{message.imageUrl}}" mode="aspectFill" bindtap="onPreviewImage"></image>
        </view>
      </view>

      <view class="message-meta">
        <text class="meta-time text-xs text-tip">{{message.time}}</text>
      </view>
    </view>
  </view>
</view>
