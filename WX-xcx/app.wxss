/* ========== CSS 变量定义 ========== */
page {
  --color-primary: #e94560;
  --color-primary-dark: #c23152;
  --color-primary-light: #ff6b81;
  --color-secondary: #0f3460;
  --color-bg: #f5f5f5;
  --color-bg-white: #ffffff;
  --color-bg-dark: #1a1a2e;
  --color-text-primary: #333333;
  --color-text-secondary: #666666;
  --color-text-tip: #999999;
  --color-text-white: #ffffff;
  --color-border: #eeeeee;
  --color-success: #07c160;
  --color-warning: #ff976a;
  --color-danger: #e94560;
  --color-gold: #ffd700;

  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  --font-size-xs: 22rpx;
  --font-size-sm: 24rpx;
  --font-size-md: 28rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 36rpx;
  --font-size-xxl: 44rpx;

  --border-radius-sm: 8rpx;
  --border-radius-md: 12rpx;
  --border-radius-lg: 16rpx;
  --border-radius-round: 50%;

  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);

  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--color-text-primary);
  background-color: var(--color-bg);
  box-sizing: border-box;
}

/* ========== 通用工具类 ========== */

/* Flex 布局 */
.flex {
  display: flex;
}
.flex-col {
  display: flex;
  flex-direction: column;
}
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-wrap {
  flex-wrap: wrap;
}
.flex-1 {
  flex: 1;
}
.align-center {
  align-items: center;
}
.justify-center {
  justify-content: center;
}
.justify-end {
  justify-content: flex-end;
}

/* 文字对齐 */
.text-left { text-align: left; }
.text-center { text-align: center; }
.text-right { text-align: right; }

/* 文字颜色 */
.text-primary { color: var(--color-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-tip { color: var(--color-text-tip); }
.text-white { color: var(--color-text-white); }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-danger { color: var(--color-danger); }

/* 文字大小 */
.text-xs { font-size: var(--font-size-xs); }
.text-sm { font-size: var(--font-size-sm); }
.text-md { font-size: var(--font-size-md); }
.text-lg { font-size: var(--font-size-lg); }
.text-xl { font-size: var(--font-size-xl); }
.text-xxl { font-size: var(--font-size-xxl); }

/* 文字粗细 */
.font-bold { font-weight: bold; }
.font-normal { font-weight: normal; }

/* 文字溢出 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 间距 */
.mt-xs { margin-top: var(--spacing-xs); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }
.mb-xs { margin-bottom: var(--spacing-xs); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.mb-xl { margin-bottom: var(--spacing-xl); }
.ml-sm { margin-left: var(--spacing-sm); }
.ml-md { margin-left: var(--spacing-md); }
.mr-sm { margin-right: var(--spacing-sm); }
.mr-md { margin-right: var(--spacing-md); }

.pt-sm { padding-top: var(--spacing-sm); }
.pt-md { padding-top: var(--spacing-md); }
.pt-lg { padding-top: var(--spacing-lg); }
.pb-sm { padding-bottom: var(--spacing-sm); }
.pb-md { padding-bottom: var(--spacing-md); }
.pb-lg { padding-bottom: var(--spacing-lg); }
.pl-md { padding-left: var(--spacing-md); }
.pl-lg { padding-left: var(--spacing-lg); }
.pr-md { padding-right: var(--spacing-md); }
.pr-lg { padding-right: var(--spacing-lg); }
.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }

/* 背景 */
.bg-white { background-color: var(--color-bg-white); }
.bg-primary { background-color: var(--color-primary); }
.bg-dark { background-color: var(--color-bg-dark); }

/* 圆角 */
.radius-sm { border-radius: var(--border-radius-sm); }
.radius-md { border-radius: var(--border-radius-md); }
.radius-lg { border-radius: var(--border-radius-lg); }
.radius-round { border-radius: var(--border-radius-round); }

/* 阴影 */
.shadow-sm { box-shadow: var(--shadow-sm); }
.shadow-md { box-shadow: var(--shadow-md); }

/* 隐藏 */
.hidden { display: none !important; }

/* 分割线 */
.divider {
  width: 100%;
  height: 1rpx;
  background-color: var(--color-border);
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ========== 按钮样式 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--border-radius-md);
  font-size: var(--font-size-lg);
  border: none;
  outline: none;
  transition: opacity 0.2s;
}
.btn::after {
  border: none;
}
.btn:active {
  opacity: 0.8;
}

.btn-primary {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  color: var(--color-text-white);
}

.btn-secondary {
  background-color: var(--color-secondary);
  color: var(--color-text-white);
}

.btn-outline {
  background-color: transparent;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
}

.btn-ghost {
  background-color: transparent;
  color: var(--color-text-primary);
}

.btn-danger {
  background-color: var(--color-danger);
  color: var(--color-text-white);
}

.btn-sm {
  height: 60rpx;
  padding: 0 var(--spacing-md);
  font-size: var(--font-size-sm);
  border-radius: var(--border-radius-sm);
}

.btn-block {
  width: 100%;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ========== 卡片样式 ========== */
.card {
  background-color: var(--color-bg-white);
  border-radius: var(--border-radius-md);
  padding: var(--spacing-md);
  margin: var(--spacing-sm) var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--spacing-sm);
  border-bottom: 1rpx solid var(--color-border);
}

.card-body {
  padding: var(--spacing-sm) 0;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-border);
}

/* ========== 表单样式 ========== */
.form-group {
  margin-bottom: var(--spacing-md);
}

.form-label {
  display: block;
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-xs);
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--spacing-md);
  background-color: var(--color-bg);
  border-radius: var(--border-radius-sm);
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: var(--spacing-sm) var(--spacing-md);
  background-color: var(--color-bg);
  border-radius: var(--border-radius-sm);
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.form-placeholder {
  color: var(--color-text-tip);
}

.form-error {
  font-size: var(--font-size-xs);
  color: var(--color-danger);
  margin-top: var(--spacing-xs);
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 var(--spacing-md);
  background-color: var(--color-bg-white);
  border-bottom: 1rpx solid var(--color-border);
}

.form-item-label {
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  flex-shrink: 0;
  margin-right: var(--spacing-md);
}

.form-item-value {
  flex: 1;
  text-align: right;
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
}

.form-item-arrow {
  width: 32rpx;
  height: 32rpx;
  margin-left: var(--spacing-sm);
}

/* ========== 标签/徽章 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  font-size: var(--font-size-xs);
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.tag-primary {
  background-color: rgba(233, 69, 96, 0.1);
  color: var(--color-primary);
}

.tag-success {
  background-color: rgba(7, 193, 96, 0.1);
  color: var(--color-success);
}

.tag-warning {
  background-color: rgba(255, 151, 106, 0.1);
  color: var(--color-warning);
}

.tag-gold {
  background-color: rgba(255, 215, 0, 0.15);
  color: var(--color-gold);
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: var(--spacing-md);
}

.empty-state-text {
  font-size: var(--font-size-md);
  color: var(--color-text-tip);
}

/* ========== 加载状态 ========== */
.loading-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.loading-more {
  text-align: center;
  padding: 20rpx 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-tip);
}

.no-more {
  text-align: center;
  padding: 20rpx 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-tip);
}

/* ========== 通用纯CSS图标集合 ========== */
/* 通用空态 */
.empty-icon-bg {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  position: relative;
  display: block;
}
.empty-icon-bg.risk { background: rgba(239, 68, 68, 0.08); }
.empty-icon-bg.risk::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 30rpx;
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #EF4444;
  border-radius: 10rpx;
  transform: translateX(-50%);
}
.empty-icon-bg.risk::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 42rpx;
  width: 6rpx;
  height: 24rpx;
  background: #EF4444;
  border-radius: 3rpx;
  transform: translateX(-50%);
  box-shadow: 0 32rpx 0 #EF4444;
}

.empty-icon-bg.pkg { background: rgba(107,114,128,0.1); }
.empty-icon-bg.pkg::after {
  content: "";
  position: absolute;
  left: 50%; top: 50%;
  width: 56rpx; height: 44rpx;
  border: 5rpx solid #9CA3AF;
  border-radius: 6rpx;
  transform: translate(-50%,-50%);
}
.empty-icon-bg.pkg::before {
  content: "";
  position: absolute;
  left: 50%; top: 34rpx;
  width: 28rpx; height: 10rpx;
  border-bottom: 4rpx solid #9CA3AF;
  transform: translateX(-50%);
}

.empty-icon-bg.history { background: rgba(96,165,250,0.1); }
.empty-icon-bg.history::after {
  content: "";
  position: absolute;
  left: 50%; top: 30rpx;
  width: 48rpx; height: 52rpx;
  border: 5rpx solid #60A5FA;
  border-radius: 4rpx;
  transform: translateX(-50%);
}
.empty-icon-bg.history::before {
  content: "";
  position: absolute;
  left: 50%; top: 42rpx;
  width: 28rpx; height: 4rpx;
  background: #60A5FA;
  box-shadow: 0 10rpx 0 #60A5FA, 0 20rpx 0 #60A5FA;
  transform: translateX(-50%);
}

.empty-icon-bg.chat { background: rgba(96,165,250,0.1); }
.empty-icon-bg.chat::after {
  content: "";
  position: absolute;
  left: 32rpx; top: 32rpx;
  width: 48rpx; height: 38rpx;
  border: 5rpx solid #60A5FA;
  border-radius: 10rpx 10rpx 10rpx 0;
}
.empty-icon-bg.chat::before {
  content: "";
  position: absolute;
  left: 32rpx; bottom: 28rpx;
  border-right: 14rpx solid transparent;
  border-top: 14rpx solid #60A5FA;
}

.empty-icon-bg.group { background: rgba(139,92,246,0.1); }
.empty-icon-bg.group::after, .empty-icon-bg.group::before {
  content: "";
  position: absolute;
  top: 34rpx;
  width: 28rpx; height: 28rpx;
  border: 5rpx solid #8B5CF6;
  border-radius: 50%;
}
.empty-icon-bg.group::before { left: 24rpx; }
.empty-icon-bg.group::after { right: 24rpx; }

.empty-icon-bg.shield { background: rgba(16,185,129,0.1); }
.empty-icon-bg.shield::after {
  content: "";
  position: absolute;
  left: 50%; top: 28rpx;
  width: 44rpx; height: 56rpx;
  border: 5rpx solid #10B981;
  border-radius: 6rpx 6rpx 24rpx 24rpx;
  transform: translateX(-50%);
}
.empty-icon-bg.shield::before {
  content: "";
  position: absolute;
  left: 50%; top: 44rpx;
  width: 8rpx; height: 8rpx;
  background: #10B981;
  box-shadow: 12rpx 0 0 #10B981, -12rpx 0 0 #10B981, 0 10rpx 0 #10B981;
  transform: translateX(-50%);
}

.empty-icon-bg.camera { background: rgba(245,158,11,0.1); }
.empty-icon-bg.camera::after {
  content: "";
  position: absolute;
  left: 50%; top: 36rpx;
  width: 48rpx; height: 36rpx;
  border: 5rpx solid #F59E0B;
  border-radius: 6rpx;
  transform: translateX(-50%);
}
.empty-icon-bg.camera::before {
  content: "";
  position: absolute;
  left: 50%; top: 44rpx;
  width: 16rpx; height: 16rpx;
  border: 4rpx solid #F59E0B;
  border-radius: 50%;
  transform: translateX(-50%);
}

/* 统计点 */
.stat-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 6rpx;
  vertical-align: middle;
  position: relative;
}
.stat-dot.star { background: #F59E0B; }
.stat-dot.star::after {
  content: "";
  position: absolute;
  left: 50%; top: 50%;
  width: 0; height: 0;
  border-left: 4rpx solid transparent;
  border-right: 4rpx solid transparent;
  border-bottom: 8rpx solid #fff;
  transform: translate(-50%,-80%) rotate(-36deg);
}
.stat-dot.order { background: #3B82F6; border-radius: 4rpx; }
.stat-dot.chat { background: #10B981; border-radius: 4rpx 4rpx 4rpx 0; }

.mini-dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  display: inline-block;
  margin-right: 6rpx;
  vertical-align: middle;
  position: relative;
}
.mini-dot.star { background: #F59E0B; }
.mini-dot.star::after {
  content: "";
  position: absolute;
  left: 50%; top: 50%;
  width: 0; height: 0;
  border-left: 3rpx solid transparent;
  border-right: 3rpx solid transparent;
  border-bottom: 6rpx solid #fff;
  transform: translate(-50%,-80%) rotate(-36deg);
}

/* 提示图标 */
.tip-icon-bg {
  width: 28rpx; height: 28rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  position: relative;
  display: inline-block;
  vertical-align: middle;
  margin-right: 12rpx;
}
.tip-icon-bg.warn {
  background: #EF4444;
  margin-right: 0;
}
.tip-icon-bg.warn::after {
  content: "";
  position: absolute;
  left: 50%; top: 6rpx;
  width: 4rpx; height: 12rpx;
  background: #fff;
  border-radius: 2rpx;
  transform: translateX(-50%);
}
.tip-icon-bg.warn::before {
  content: "";
  position: absolute;
  left: 50%; bottom: 6rpx;
  width: 4rpx; height: 4rpx;
  background: #fff;
  border-radius: 50%;
  transform: translateX(-50%);
}
.tip-icon-bg.lock {
  background: #3B82F6;
  margin-right: 0;
}
.tip-icon-bg.lock::after {
  content: "";
  position: absolute;
  left: 50%; top: 50%;
  width: 14rpx; height: 10rpx;
  border: 3rpx solid #fff;
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
  transform: translate(-50%, calc(-50% + 2rpx));
}
.tip-icon-bg.lock::before {
  content: "";
  position: absolute;
  left: 50%; top: 8rpx;
  width: 10rpx; height: 10rpx;
  border: 3rpx solid #fff;
  border-radius: 50% 50% 0 0;
  border-bottom: none;
  transform: translateX(-50%);
}
.tip-icon-bg.phone {
  background: #10B981;
  margin-right: 0;
}
.tip-icon-bg.phone::after {
  content: "";
  position: absolute;
  left: 50%; top: 50%;
  width: 12rpx; height: 14rpx;
  border: 3rpx solid #fff;
  border-radius: 2rpx;
  transform: translate(-50%,-50%);
}
.tip-icon-bg.bell {
  background: #F59E0B;
  margin-right: 0;
}
.tip-icon-bg.bell::after {
  content: "";
  position: absolute;
  left: 50%; top: 6rpx;
  width: 14rpx; height: 14rpx;
  border: 3rpx solid #fff;
  border-radius: 50% 50% 0 0;
  border-bottom: none;
  transform: translateX(-50%);
  box-shadow: inset 0 -6rpx 0 #fff;
}
.tip-icon-bg.bell::before {
  content: "";
  position: absolute;
  left: 50%; bottom: 6rpx;
  width: 8rpx; height: 4rpx;
  background: #fff;
  border-radius: 0 0 4rpx 4rpx;
  transform: translateX(-50%);
}

/* 更多面板图标 */
.panel-icon-bg {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  margin: 0 auto 16rpx;
  position: relative;
  display: block;
}
.panel-icon-bg.camera { background: #EEF2FF; }
.panel-icon-bg.camera::after {
  content: "";
  position: absolute;
  left: 50%; top: 28rpx;
  width: 48rpx; height: 36rpx;
  border: 5rpx solid #6366F1;
  border-radius: 8rpx;
  transform: translateX(-50%);
}
.panel-icon-bg.camera::before {
  content: "";
  position: absolute;
  left: 50%; top: 36rpx;
  width: 16rpx; height: 16rpx;
  border: 4rpx solid #6366F1;
  border-radius: 50%;
  transform: translateX(-50%);
}
.panel-icon-bg.photo { background: #FEF3C7; }
.panel-icon-bg.photo::after {
  content: "";
  position: absolute;
  left: 50%; top: 28rpx;
  width: 48rpx; height: 36rpx;
  border: 5rpx solid #F59E0B;
  border-radius: 8rpx;
  transform: translateX(-50%);
}
.panel-icon-bg.photo::before {
  content: "";
  position: absolute;
  left: 50%; top: 36rpx;
  width: 16rpx; height: 16rpx;
  background: #F59E0B;
  border-radius: 50%;
  transform: translateX(-50%);
}
.panel-icon-bg.file { background: #DBEAFE; }
.panel-icon-bg.file::after {
  content: "";
  position: absolute;
  left: 50%; top: 20rpx;
  width: 40rpx; height: 52rpx;
  border: 5rpx solid #3B82F6;
  border-radius: 4rpx;
  transform: translateX(-50%);
}
.panel-icon-bg.file::before {
  content: "";
  position: absolute;
  left: 50%; top: 32rpx;
  width: 22rpx; height: 4rpx;
  background: #3B82F6;
  box-shadow: 0 8rpx 0 #3B82F6, 0 16rpx 0 #3B82F6, 0 24rpx 0 #3B82F6;
  transform: translateX(-50%);
}
.panel-icon-bg.card { background: #FCE7F3; }
.panel-icon-bg.card::after {
  content: "";
  position: absolute;
  left: 50%; top: 28rpx;
  width: 56rpx; height: 36rpx;
  border: 5rpx solid #EC4899;
  border-radius: 8rpx;
  transform: translateX(-50%);
}
.panel-icon-bg.card::before {
  content: "";
  position: absolute;
  left: 50%; top: 46rpx;
  width: 20rpx; height: 4rpx;
  background: #EC4899;
  box-shadow: 14rpx 0 0 #EC4899;
  transform: translateX(-70%);
}
.panel-icon-bg.mic { background: #FEE2E2; }
.panel-icon-bg.mic::after {
  content: "";
  position: absolute;
  left: 50%; top: 22rpx;
  width: 20rpx; height: 32rpx;
  border: 5rpx solid #EF4444;
  border-radius: 12rpx;
  transform: translateX(-50%);
}
.panel-icon-bg.mic::before {
